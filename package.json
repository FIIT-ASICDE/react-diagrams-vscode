{
  "name": "react-diagrams-vscode",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start:webview-ui": "npm --workspace @react-diagrams/webview-ui run dev",
    "watch:webview-ui": "npm --workspace @react-diagrams/webview-ui run watch",
    "watch:core": "npm --workspace @react-diagrams/core run watch",
    "watch:dev": "npm-run-all -p watch:core watch:webview-ui watch",
    "watch": "npm --workspace @react-diagrams/vscode-extension run watch",
    "watch-tests": "npm --workspace @react-diagrams/vscode-extension run watch-tests",
    "compile": "npm --workspace @react-diagrams/vscode-extension run compile",
    "compile-tests": "npm --workspace @react-diagrams/vscode-extension run compile-tests",
    "lint": "npm run lint --workspaces",
    "test": "npm --workspace @react-diagrams/core run test && npm --workspace @react-diagrams/vscode-extension run test",
    "build": "npm --workspace @react-diagrams/core run build && npm --workspace @react-diagrams/webview-ui run build && npm --workspace @react-diagrams/vscode-extension run compile"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "bun": "1.3.11"
  }
}