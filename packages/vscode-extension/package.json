{
  "name": "@react-diagrams/vscode-extension",
  "displayName": "vs-code-ext",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.111.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onChatParticipant:vs-code-ext.diagram"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "vs-code-ext.diagram",
        "name": "diagram",
        "fullName": "Diagram Assistant",
        "description": "Understands TypeScript, TSX, and activity diagrams using your current code and diagram context.",
        "isSticky": true
      }
    ],
    "commands": [
      {
        "command": "vs-code-ext.componentState",
        "title": "React Component State"
      },
      {
        "command": "vs-code-ext.componentActivity",
        "title": "React Component Activity"
      }
    ],
    "configuration": {
      "title": "React diagrams",
      "properties": {
        "state.diagram.openStatePanelOnTheSide": {
          "type": "boolean",
          "default": true,
          "description": "Open the State Diagram panel on the side instead of the main area"
        },
        "state.diagram.backgroundColor": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumItemLabels": [
            "Auto",
            "Force Light",
            "Force Dark"
          ],
          "enumDescriptions": [
            "Uses the vscode theme.",
            "Ignore theme and use a white background.",
            "Ignore theme and use a dark background."
          ],
          "description": "The background color mode of State Diagram."
        },
        "state.diagram.transitionRouting": {
          "type": "string",
          "default": "POLYLINE",
          "enum": [
            "POLYLINE",
            "ORTHOGONAL",
            "SPLINES"
          ],
          "enumDescriptions": [
            "Shorter transition with graceful turns.",
            "Longer transition with sharp turns.",
            "Combination of POLYLINE and ORTHOGONAL."
          ],
          "description": "Specifies the routing algorithm for transitions in the state diagram."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:webview && npm run package",
    "precompile": "npm --workspace @react-diagrams/core run build",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/data-urls": "^3.0.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "chokidar-cli": "^3.0.0",
    "eslint": "^9.39.2",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@react-diagrams/core": "file:../core",
    "data-urls": "^7.0.0"
  }
}
