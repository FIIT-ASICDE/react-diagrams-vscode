{
  "name": "@react-diagrams/vscode-extension",
  "displayName": "vs-code-ext",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.111.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onChatParticipant:vs-code-ext.diagram"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "vs-code-ext.diagram",
        "name": "diagram",
        "fullName": "Activity Diagram Assistant",
        "description": "Understands TypeScript, TSX, and activity diagrams using your current code and diagram context.",
        "isSticky": true
      }
    ],
    "commands": [
      {
        "command": "vs-code-ext.componentState",
        "title": "React Component State"
      },
      {
        "command": "vs-code-ext.componentActivity",
        "title": "React Component Activity"
      }
    ],
    "languageModelTools": [
      {
        "name": "create_activity_diagram",
        "displayName": "Create Activity Diagram",
        "modelDescription": "Creates and displays an activity diagram from the current code file or from a specific function when that helps explain control flow.",
        "toolReferenceName": "create_activity_diagram",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "functionName": {
              "type": "string",
              "description": "Optional function name to focus on."
            },
            "sourceText": {
              "type": "string",
              "description": "Optional source text to parse directly."
            },
            "title": {
              "type": "string",
              "description": "Optional diagram title."
            }
          }
        }
      }
    ],
    "configuration": {
      "title": "Diagram Assistant",
      "properties": {
        "diagramAssistant.enableDebug": {
          "type": "boolean",
          "default": true,
          "description": "Show debug information in chat about which sources were available and used."
        },
        "diagramAssistant.enableDiagramGeneration": {
          "type": "boolean",
          "default": true,
          "description": "Allow the assistant to generate an activity diagram when code is visible."
        },
        "diagramAssistant.primaryReasoningSource": {
          "type": "string",
          "enum": [
            "code",
            "diagram",
            "image"
          ],
          "default": "diagram",
          "description": "Primary source the assistant should prefer during reasoning."
        },
        "diagramAssistant.includeCodeContext": {
          "type": "boolean",
          "default": true,
          "description": "Include code context when available."
        },
        "diagramAssistant.includeDiagramJson": {
          "type": "boolean",
          "default": true,
          "description": "Include diagram JSON when available."
        },
        "diagramAssistant.includeDiagramImage": {
          "type": "boolean",
          "default": true,
          "description": "Include rendered diagram image when available."
        },
        "diagramAssistant.whenCodeVisible.allowDiagramGeneration": {
          "type": "boolean",
          "default": true,
          "description": "Allow diagram generation when the visible surface is code."
        },
        "diagramAssistant.whenCodeVisible.includeGeneratedDiagramJson": {
          "type": "boolean",
          "default": true,
          "description": "Include generated diagram JSON after diagram generation from code."
        },
        "diagramAssistant.whenCodeVisible.includeGeneratedDiagramImage": {
          "type": "boolean",
          "default": true,
          "description": "Include generated diagram image after diagram generation from code."
        },
        "diagramAssistant.whenDiagramVisible.includeFullCode": {
          "type": "boolean",
          "default": true,
          "description": "Include full code context when a diagram is already visible."
        },
        "diagramAssistant.whenDiagramVisible.includeDiagramJson": {
          "type": "boolean",
          "default": true,
          "description": "Include diagram JSON when a diagram is already visible."
        },
        "diagramAssistant.whenDiagramVisible.includeDiagramImage": {
          "type": "boolean",
          "default": true,
          "description": "Include diagram image when a diagram is already visible."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:webview && npm run package",
    "precompile": "npm --workspace @react-diagrams/core run build",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "chokidar-cli": "^3.0.0",
    "eslint": "^9.39.2",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@react-diagrams/core": "file:../core"
  }
}