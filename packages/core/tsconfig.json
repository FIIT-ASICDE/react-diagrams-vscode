{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "declaration": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noImplicitAny": false,
    "allowUnreachableCode": false,
    // "paths": { // dsnt work for god knows what reason...
    //   "#/*": ["./src/*"]
    // }
    "typeRoots": [
      "../../node_modules/@types",
      "./node_modules/@types"
    ],
    "noImplicitAny": false
  },
  "include": [
    "src/**/*.ts", 
    "src/tests/playground.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}